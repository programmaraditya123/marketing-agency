# Primary AI Provider: Krutrim Cloud
KRUTRIM_API_KEY=
KRUTRIM_MODEL=gpt-oss-120b
KRUTRIM_BASE_URL=https://cloud.olakrutrim.com/v1

# Secondary / Fallback AI Provider: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Use the same random secret in Backend/.env (at least 32 characters).
MICROSERVICE_TOKEN=
# CORS origins are fixed in config/cors.py; environment overrides are ignored.
