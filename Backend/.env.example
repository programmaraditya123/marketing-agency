PORT=9000
HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=marketing_agency
MICROSERVICE_URL=http://127.0.0.1:8000
# Use the same random secret in Microservice/.env (at least 32 characters).
MICROSERVICE_TOKEN=
CORS_ORIGINS=http://localhost:3000
# Separate random signing secret (at least 32 characters); never reuse MICROSERVICE_TOKEN.
JWT_SECRET=
# Production automatically enables Secure. Use None only for HTTPS cross-site deployments.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
